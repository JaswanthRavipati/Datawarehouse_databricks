{
  "datasets": [
    {
      "name": "57aea432",
      "displayName": "Monthly Sales Aggregated by Order Date",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `salesdb`;\n",
        "\n",
        "SELECT \n",
        "date_trunc('month',order_date) AS month,\n",
        "SUM(sales_amount)\n",
        "FROM fact_sales\n",
        "GROUP BY month\n"
      ]
    },
    {
      "name": "9560b757",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `salesdb`;\n",
        "\n",
        "SELECT\n",
        "SUM(s.sales_amount),\n",
        "p.category\n",
        "FROM fact_sales s\n",
        "LEFT JOIN dim_products p\n",
        "ON p.product_key = s.product_key\n",
        "GROUP BY category"
      ]
    },
    {
      "name": "customer_sales",
      "displayName": "Total Sales and Quantity from Customers",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "\n",
        "USE SCHEMA `salesdb`;\n",
        "\n",
        "SELECT\n",
        "  SUM(s.sales_amount) AS total_sales,\n",
        "  SUM(s.quantity) AS total_quantity,\n",
        "  SUM(s.sales_amount - (s.quantity * p.cost)) AS total_profit,\n",
        "  p.category,\n",
        "  date_trunc('month', s.order_date) AS month,\n",
        "  c.country\n",
        "FROM\n",
        "  fact_sales s\n",
        "    INNER JOIN dim_customers c\n",
        "      ON s.customer_key = c.customer_key\n",
        "    INNER JOIN dim_products p\n",
        "      ON s.product_key = p.product_key\n",
        "WHERE\n",
        "  c.country IS NOT NULL\n",
        "  AND c.country != ''\n",
        "  AND LOWER(c.country) != 'n/a'\n",
        "GROUP BY\n",
        "  p.category,\n",
        "  date_trunc('month', s.order_date),\n",
        "  c.country"
      ]
    }
  ],
