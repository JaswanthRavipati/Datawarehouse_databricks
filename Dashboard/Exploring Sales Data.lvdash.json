{
  "datasets": [
    {
      "name": "57aea432",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `salesdb`;\n",
        "\n",
        "SELECT \n",
        "date_trunc('month',order_date) AS month,\n",
        "SUM(sales_amount)\n",
        "FROM fact_sales\n",
        "GROUP BY month\n"
      ]
    },
    {
      "name": "9560b757",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `salesdb`;\n",
        "\n",
        "SELECT\n",
        "SUM(s.sales_amount),\n",
        "p.category\n",
        "FROM fact_sales s\n",
        "LEFT JOIN dim_products p\n",
        "ON p.product_key = s.product_key\n",
        "GROUP BY category"
      ]
    }
  ],
